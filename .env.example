# Server (use 3001 locally if profiles already uses 3000)
APP_PORT=3001
PORT=3001 # optional
# Docker Compose production host port
HOST_PORT=18086
SERVICE_NAME=quiz_api # optional
BODY_LIMIT=5mb # optional
CORS_ORIGINS=https://uside.id.vn,https://www.uside.id.vn,https://app.uside.id.vn,https://profiles.uside.id.vn,https://quizzes.uside.id.vn # optional

# Shared production PostgreSQL. DATABASE_URL is generated by CI/CD.
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=quizzes
DB_USERNAME=quizzes_app
DB_PASSWORD=
DB_SCHEMA=public
# Optional direct URL for host development (use localhost:5433).
DATABASE_URL= # optional
DB_POOL_MAX=10 # optional
DB_POOL_WARM=4 # optional
DB_POOL_IDLE_MS=300000 # optional
DB_POOL_CONNECT_TIMEOUT_MS=10000 # optional
DB_POOL_KEEPALIVE_DELAY_MS=10000 # optional
PRISMA_TX_MAX_WAIT_MS=10000 # optional
PRISMA_TX_TIMEOUT_MS=20000 # optional
REQUEST_QUERY_LOG=false # optional

# Shared Redis: database 0, application namespace.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=quizzes:
# Optional legacy URL for host development; unset REDIS_HOST to use it.
REDIS_URL= # optional

# Profiles auth proxy
PROFILES_API_BASE_URL=http://bcn_profiles:3000
PROFILES_HTTP_TIMEOUT_MS=10000 # optional
PROFILES_WARMUP_TIMEOUT_MS=3000 # optional
# Revalidate every request for immediate cross-app logout/block/role changes.
# A positive TTL explicitly accepts stale authorization until expiry.
AUTH_CACHE_TTL_MS=0 # optional

# MinIO
MINIO_IMAGE_MAX_BYTES=3145728 # optional
MINIO_QUIZ_IMAGE_FOLDER=quiz-images # optional
MINIO_TOPIC_IMAGE_FOLDER=topic-images # optional
MINIO_COURSE_IMAGE_FOLDER=course-images # optional
MINIO_PROJECT_FOLDER=project-submissions # optional
MINIO_PROJECT_REQUIREMENT_FOLDER=project-requirements # optional

# GET response cache (shared catalog only)
GET_CACHE_ENABLED=true # optional
GET_CACHE_TTL_MS=20000 # optional

# Logging
LOG_LEVEL=info # optional
LOG_DIR=logs # optional
LOG_FILE_ENABLED=false # optional
LOKI_ENABLED=false # optional
LOKI_HOST= # optional
LOKI_BASIC_AUTH= # optional
LOKI_BATCH_INTERVAL_SECONDS=5 # optional
LOKI_TIMEOUT_MS=10000 # optional

# Shared MinIO: sign PUT/GET URLs using this exact HTTPS endpoint.
MINIO_ENDPOINT=https://storage.bcn.id.vn
MINIO_BUCKET=quizzes
MINIO_ACCESS_KEY=yQKgg2HqGRYWlP6s92Bx
MINIO_SECRET_KEY=YyJYtDA0iQsHGoxOClD3CVrvu1lVnmBZbCy5cshB
MINIO_REGION=us-east-1 # optional
MINIO_FORCE_PATH_STYLE=true
