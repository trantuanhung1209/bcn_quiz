# Server (use 3001 locally if profiles already uses 3000)
PORT=3001
SERVICE_NAME=quiz_api
BODY_LIMIT=5mb
CORS_ORIGINS=

# Database — shared Postgres instance, database `bcn_quiz`
# (start infra from NestJS/: docker compose up -d)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bcn_quiz?schema=public
DB_POOL_MAX=10
DB_POOL_WARM=4
DB_POOL_IDLE_MS=300000
DB_POOL_CONNECT_TIMEOUT_MS=10000
DB_POOL_KEEPALIVE_DELAY_MS=10000
PRISMA_TX_MAX_WAIT_MS=10000
PRISMA_TX_TIMEOUT_MS=20000
REQUEST_QUERY_LOG=false

# Redis — shared with bcn_profiles
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=bcn:quiz:
# REDIS_PASSWORD=
# REDIS_SENTINELS=127.0.0.1:26379,127.0.0.1:26380,127.0.0.1:26381
# REDIS_SENTINEL_NAME=mymaster
# REDIS_SENTINEL_PASSWORD=

# Profiles auth proxy
PROFILES_API_BASE_URL=http://localhost:3000
PROFILES_HTTP_TIMEOUT_MS=10000
PROFILES_WARMUP_TIMEOUT_MS=3000
AUTH_CACHE_TTL_MS=60000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_IMAGE_FORMAT=webp
CLOUDINARY_IMAGE_QUALITY=
CLOUDINARY_IMAGE_MAX_BYTES=
CLOUDINARY_QUIZ_IMAGE_FOLDER=quiz-images
CLOUDINARY_TOPIC_IMAGE_FOLDER=topic-images
CLOUDINARY_COURSE_IMAGE_FOLDER=course-images
CLOUDINARY_PROJECT_FOLDER=project-submissions
CLOUDINARY_PROJECT_REQUIREMENT_FOLDER=project-requirements

# GET response cache (shared catalog only)
GET_CACHE_ENABLED=true
GET_CACHE_TTL_MS=20000

# Logging
LOG_LEVEL=info
LOG_DIR=logs
LOG_FILE_ENABLED=true
LOKI_ENABLED=false
LOKI_HOST=
LOKI_BASIC_AUTH=
LOKI_BATCH_INTERVAL_SECONDS=5
LOKI_TIMEOUT_MS=10000
